<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS 18 UI Kit "Acticity Idle" pill: #1E1E1E at 50% under a 40% white hairline, 35.6 px corners on a 62 px pill
     (fully round), with the Liquid Glass rim. Focused: white, as tvOS focuses a button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#801E1E1E" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#29FFFFFF" android:centerColor="#08FFFFFF"
                        android:endColor="#0DFFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="0.5dp" android:color="#66FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
